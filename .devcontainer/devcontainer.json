{
  "name": "PMO IDIEM - Python",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/git:1": {},
    "ghcr.io/devcontainers/features/node:1": {
      "version": "lts",
      "pnpmVersion": "none"
    }
  },
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "MkDocs PMO",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "eamodio.gitlens",
        "yzhang.markdown-all-in-one",
        "marp-team.marp-vscode",
        "redhat.vscode-yaml"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.terminal.activateEnvironment": true,
        "editor.formatOnSave": true,
        "markdown.marp.enableHtml": true
      }
    }
  },
  "postCreateCommand": "python -m pip install --upgrade pip pyyaml mkdocs-material --trusted-host pypi.org --trusted-host files.pythonhosted.org; npm install -g @marp-team/marp-cli --strict-ssl=false || echo 'AVISO: Marp CLI no se pudo instalar (revisar certificados de red)'",
  "remoteUser": "vscode"
}
